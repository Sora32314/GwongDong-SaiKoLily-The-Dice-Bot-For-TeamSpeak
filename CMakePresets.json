{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "core debug",
            "displayName": "Debug Build",
            "description": "Build Core Target With Debug Info.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/Build/Debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_STANDARD": "23",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/Build/Debug/bin",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/Build/Debug/lib",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/Build/Debug/lib",
                "ENABLE_CPPCHECK": true,
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "core release",
            "displayName": "Release Build",
            "description": "Build Core Target In Release.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/Build/Release",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_STANDARD": "23",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/Build/Release/bin",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/Build/Release/lib",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/Build/Release/lib",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux_x86_64 release",
            "displayName": "Linux Release Build",
            "description": "Build Core Target In Linux x86_64 Platform Release.",
            "generator": "Ninja",
            "binaryDir": "$env{HOME}/project/GwongDong_SaiKoLily/Linux-Release/",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",

                "ENABLE_CPPCHECK": false,
                "GD_BUILD_TESTSPACE": true,

                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "$env{HOME}/project/GwongDong_SaiKoLily/Linux-Release/lib",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "$env{HOME}/project/GwongDong_SaiKoLily/Linux-Release/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "$env{HOME}/project/GwongDong_SaiKoLily/Linux-Release/bin",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ci windows",
            "displayName": "ci windows",
            "description": "Build Core Target In Windows CI Release.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/Build/CI-Windows",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",

                "ENABLE_CPPCHECK": false,
                "GD_BUILD_TESTSPACE": false,

                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/Build/CI-Windows/lib",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/Build/CI-Windows/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/Build/CI-Windows/bin",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ci linux",
            "displayName": "ci linux",
            "description": "Build Core Target In Linux CI Release.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/GwongDong_SaiKoLily/Build/CI-Linux/",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc-16",
                "CMAKE_CXX_COMPILER": "g++-16",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",

                "ENABLE_CPPCHECK": false,
                "GD_BUILD_TESTSPACE": false,

                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/GwongDong_SaiKoLily/Build/CI-Linux/lib",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/GwongDong_SaiKoLily/Build/CI-Linux/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/GwongDong_SaiKoLily/Build/CI-Linux/bin",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug Build",
            "configurePreset": "core debug",
            "configuration": "Debug",
            "targets": [
                "Plugin_GwongDong",
                "encapsulation_spdlog",
                "saiko_lily",
                "command_core"
            ]
        },
        {
            "name": "Release Build",
            "configurePreset": "core release",
            "configuration": "Release",
            "targets": [
                "Plugin_GwongDong",
                "encapsulation_spdlog",
                "saiko_lily",
                "command_core"
            ]
        },
        {
            "name": "Test Build",
            "configurePreset": "core debug",
            "configuration": "Debug",
            "targets": [
                "Plugin_GwongDong",
                "encapsulation_spdlog",
                "saiko_lily",
                "command_core",
                "GwongDongFS_Bench"
            ]
        },
        {
            "name": "Linux Build",
            "configurePreset": "linux_x86_64 release",
            "configuration": "Release",
            "targets": [
                "Plugin_GwongDong",
                "encapsulation_spdlog",
                "saiko_lily",
                "command_core"
            ]
        },
        {
            "name": "CI Windows Build",
            "configurePreset": "ci windows",
            "configuration": "Release",
            "targets": [
                "Plugin_GwongDong",
                "encapsulation_spdlog",
                "saiko_lily",
                "command_core"
            ]
        },
        {
            "name": "CI Linux Build",
            "configurePreset": "ci linux",
            "configuration": "Release",
            "targets": [
                "Plugin_GwongDong",
                "encapsulation_spdlog",
                "saiko_lily",
                "command_core"
            ]
        },
        {
            "name": "Cppcheck Debug",
            "configurePreset": "core debug",
            "targets": [
                "cppcheck"
            ]
        },
        {
            "name": "Cppcheck XML Debug",
            "configurePreset": "core debug",
            "targets": [
                "cppcheck-xml"
            ]
        }
    ]
}